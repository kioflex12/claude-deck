{
  "name": "claude-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deck — локальный менеджер контекстов Claude Code: доска сессий + рабочая консоль (десктоп-приложение на Electron).",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.mjs",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.217"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.8.1"
  },
  "build": {
    "appId": "com.kioflex.deck",
    "productName": "Deck",
    "directories": { "output": "dist" },
    "files": [
      "electron/**",
      "server.mjs",
      "index.html",
      "node_modules/@anthropic-ai/**"
    ],
    "extraMetadata": { "main": "electron/main.cjs" },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
